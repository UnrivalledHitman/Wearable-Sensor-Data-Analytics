    "import pandas as pd, numpy as np, glob\n",
    "from collections import Counter\n",
    "\n",
    "files = sorted(glob.glob(\"data_preprocessed/*_combined.npz\"))\n",
    "for f in files:\n",
    "    arr = np.load(f)\n",
    "    y = arr[\"y\"]\n",
    "    print(f\"{f.split('/')[-1]:<20} → {Counter(y)}\")"
   ]
  }
